!  Tokamak coil model: a toroidal field conductor on the axis of symmetry with
!  eight return legs far from the plasma, and a coaxial pair of circular coils
!  for the vertical field.

&MGRID_NLI
    MGRID_EXT = 'test'
    MGRID_MODE = 'R'
    LSTELL_SYM = .FALSE.
    RMIN = 0.5
    RMAX = 1.5
    ZMIN = -0.5
    ZMAX = 0.5
    IR = 61
    JZ = 61
    KP = 12
/

** coils_dot_starts_below **
periods  1
begin filament
mirror NUL
